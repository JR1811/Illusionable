{
  "required": true,
  "package": "net.shirojr.illusionable.mixin",
  "compatibilityLevel": "JAVA_17",
  "plugin": "net.shirojr.illusionable.util.mixin.IllusionableMixinPlugin",
  "mixins": [
    "EntityMixin",
    "LivingEntityMixin",
    "compat.ImmediateSoundPlayerMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "client": [
    "client.ClientPlayNetworkingHandlerMixin",
    "client.EntityRenderDispatcherMixin",
    "client.EntityRendererMixin",
    "client.LivingEntityRendererMixin",
    "client.MessageHandlerMixin",
    "client.PlayerListHudMixin"
  ]
}